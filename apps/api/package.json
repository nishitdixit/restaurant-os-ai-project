{
  "name": "@restaurant-os/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --run dev:server & node --run dev:worker & wait",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 'test/**/*.test.ts'",
    "dev:server": "tsx watch --env-file-if-exists=.env src/main.ts",
    "demo:seed": "tsx scripts/demo/seed.ts",
    "demo:users": "tsx scripts/demo/users.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@clerk/backend": "^2.22.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@restaurant-os/domain": "workspace:*",
    "@restaurant-os/types": "workspace:*",
    "bullmq": "^6.3.11",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "openapi-types": "^12.1.3",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
