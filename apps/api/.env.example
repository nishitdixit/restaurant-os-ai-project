# API + worker (both read this file; the worker is `pnpm --filter @restaurant-os/api start:worker`), and the db:* scripts.
# Local: copy to apps/api/.env. Hosted demo (Render): set these on a shared Environment Group, never in a committed file.
# Every hosted value and where it comes from: DEPLOYMENT_RUNBOOK.md.

# --- Runtime ------------------------------------------------------------------------
# Hosted: production. Production refuses default secrets and the mock payment provider unless allowed below.
NODE_ENV=development
LOG_LEVEL=info
# Render sets PORT itself; keep 4000 locally.
PORT=4000
# true behind a hosting proxy (Render) so rate limits and logs use the customer's IP, not the proxy's.
TRUST_PROXY=false

# --- Database (required) ------------------------------------------------------------
# Local: the docker compose Postgres below. Hosted: the Supabase *Session pooler* string (Connect -> Session pooler),
#   postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (the direct db.<ref>.supabase.co host is IPv6-only; Render cannot reach it). TLS is enabled automatically.
DATABASE_URL=postgresql://restaurant_os:restaurant_os_local@localhost:5432/restaurant_os
# Connections per process. Hosted: 5, so API + worker stay under the session pooler's client limit.
DATABASE_POOL_MAX=10

# --- Redis --------------------------------------------------------------------------
# Required by the worker (notifications, payment expiry); the API uses it for shared rate limits.
# Hosted: the Render Key Value *internal* URL.
REDIS_URL=redis://localhost:6379

# --- Auth (Clerk) -------------------------------------------------------------------
# Secret key of the same Clerk application as the admin's publishable key. Required in production.
CLERK_SECRET_KEY=sk_test_replace_me
# Optional: only accept tokens issued for these origins. Hosted: the admin URL, e.g. https://<admin>.vercel.app
CLERK_AUTHORIZED_PARTIES=
# Self-service restaurant creation (roadmap Gate 4). Keep false for the pilot/demo: the pilot tenant is seeded and
# staff are invited from Settings -> Team.
SELF_SIGNUP_ENABLED=false

# --- Web origins (hosted: the real https URLs, no trailing slash) ------------------
# Browsers allowed to call the API: the storefront and the admin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Used in customer order links and merchant preview links.
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# The API's own public URL (local image URLs, payment links).
API_PUBLIC_URL=http://localhost:4000

# --- Payments (mock provider for the pilot/demo; no real money moves) ---------------
PAYMENT_PROVIDER=mock
# Signs mock payment tokens. Hosted: a unique random value (openssl rand -hex 32); the default is refused in production.
MOCK_PAYMENT_SECRET=change-me-to-a-long-random-string
PAYMENT_WINDOW_MINUTES=30
# Production refuses the mock provider unless this is true. Hosted demo: true.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
# Not used while PAYMENT_PROVIDER=mock.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications (development provider records messages; nothing is sent) --------
MOCK_NOTIFICATION_MODE=succeed
NOTIFICATION_MAX_ATTEMPTS=5

# --- Image storage ------------------------------------------------------------------
# local = files on this machine's disk (lost on every redeploy of a hosted service). Hosted: s3.
STORAGE_DRIVER=local
MEDIA_DIR=.data/media
# STORAGE_DRIVER=s3 with Supabase Storage (Project Settings -> Storage -> S3 Connection):
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION=<project region, e.g. ap-south-1>
#   S3_BUCKET=<public bucket name>
#   S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- Merchant preview links (unpublished store, draft look) -------------------------
# Signs short-lived preview links issued to signed-in staff. Hosted: a unique random value, different from the above.
PREVIEW_SECRET=change-me-to-another-long-random-string
PREVIEW_TTL_MINUTES=720

# --- One-time seed only (pnpm db:seed) ----------------------------------------------
# Links your Clerk user (Clerk dashboard -> Users -> user id) as OWNER of the pilot restaurant.
SEED_OWNER_CLERK_USER_ID=
SEED_OWNER_EMAIL=
