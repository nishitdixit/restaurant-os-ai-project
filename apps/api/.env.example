# --- Required -----------------------------------------------------------------
DATABASE_URL=postgresql://restaurant_os:restaurant_os_local@localhost:5432/restaurant_os
# Redis for the background worker (notifications, payment expiry) and shared rate limits.
REDIS_URL=redis://localhost:6379
# Clerk secret key (same Clerk app as the admin's publishable key).
CLERK_SECRET_KEY=sk_test_replace_me

# --- Web origins ----------------------------------------------------------------
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
# Optional: restrict Clerk tokens to these origins.
CLERK_AUTHORIZED_PARTIES=
# Self-service restaurant creation (roadmap Gate 4). Keep false for the pilot: the pilot tenant is seeded and
# staff are invited from Settings -> Team. Set true only for a supervised demo of the onboarding wizard.
SELF_SIGNUP_ENABLED=false

# --- Payments (mocked for the pilot) ---------------------------------------------
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=change-me-to-a-long-random-string
PAYMENT_WINDOW_MINUTES=30
# Production refuses the mock provider unless this is set explicitly.
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications (development provider records messages; nothing is sent) -------
MOCK_NOTIFICATION_MODE=succeed
NOTIFICATION_MAX_ATTEMPTS=5

# --- Image storage ------------------------------------------------------------------
STORAGE_DRIVER=local
MEDIA_DIR=.data/media
# For STORAGE_DRIVER=s3 (e.g. Supabase Storage S3 endpoint, Cloudflare R2, AWS S3):
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

LOG_LEVEL=info
