# Brand slug served by this storefront deployment.
NEXT_PUBLIC_STORE_BRAND_SLUG=pilot
# Public URL of this storefront, used for canonical URLs, sitemap and share cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API as seen from the browser, and (optionally) from the Next.js server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# Extra image hosts (comma-separated), e.g. your S3/Supabase Storage public URL.
MEDIA_PUBLIC_BASE_URLS=
# Admin app origin: allowed to embed this storefront for the live Appearance preview.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
