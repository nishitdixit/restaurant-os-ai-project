# Storefront (Next.js). Local: copy to apps/storefront/.env.local. Hosted (Vercel): Project -> Settings -> Environment Variables.
# All of these are read at build time (NEXT_PUBLIC_* and next.config.ts): after changing one on Vercel, redeploy.

# Brand slug served by this storefront deployment (the seeded pilot restaurant is "pilot").
NEXT_PUBLIC_STORE_BRAND_SLUG=pilot
# Public URL of this storefront, used for canonical URLs, sitemap and share cards. Hosted: https://<storefront>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API as seen from the browser. Hosted: https://<api>.onrender.com (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# API as seen from the Next.js server. Optional; defaults to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_URL=http://localhost:4000
# Image hosts allowed for optimised images (comma-separated). Hosted: the API's S3_PUBLIC_BASE_URL.
MEDIA_PUBLIC_BASE_URLS=
# Admin origin, allowed to embed this storefront for the Appearance live preview. Hosted: https://<admin>.vercel.app
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
