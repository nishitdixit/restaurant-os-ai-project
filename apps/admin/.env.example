# Admin (Next.js). Local: copy to apps/admin/.env.local. Hosted (Vercel): Project -> Settings -> Environment Variables.
# NEXT_PUBLIC_* values are compiled into the build: after changing one on Vercel, redeploy.

# Clerk -> API keys (same Clerk application as the API's CLERK_SECRET_KEY).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Build-time. Hosted: the Render API URL, e.g. https://<api>.onrender.com (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Build-time. Hosted: the storefront URL (Appearance live preview and "View store" links).
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
